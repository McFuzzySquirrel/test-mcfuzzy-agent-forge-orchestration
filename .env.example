# ---------------------------------------------------------------------------
# Tasker Mail environment configuration
# Copy to `.env` and adjust. All variables are documented with their defaults.
# Local defaults below match the docker-compose services (PostgreSQL + MailHog).
# ---------------------------------------------------------------------------

# --- HTTP server ---
# Port the Express app listens on.
PORT=3000

# --- PostgreSQL (docker-compose service: postgres) ---
# Host of the PostgreSQL server.
PGHOST=localhost
# Port PostgreSQL listens on (host mapping).
PGPORT=5432
# Database name (created by docker-compose via POSTGRES_DB).
PGDATABASE=tasker_mail
# PostgreSQL user (created by docker-compose via POSTGRES_USER).
PGUSER=tasker
# PostgreSQL password (created by docker-compose via POSTGRES_PASSWORD).
PGPASSWORD=tasker

# --- SMTP / email notifications (docker-compose service: mailhog) ---
# SMTP server host. Local development uses MailHog.
SMTP_HOST=localhost
# SMTP server port. MailHog's SMTP port is 1025.
SMTP_PORT=1025
# SMTP username (optional; empty for MailHog which accepts anything).
SMTP_USER=
# SMTP password (optional; empty for MailHog).
SMTP_PASS=
# "From" address used on outgoing notification emails.
SMTP_FROM=Tasker Mail <noreply@tasker.local>
